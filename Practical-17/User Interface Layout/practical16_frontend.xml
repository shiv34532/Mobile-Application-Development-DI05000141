<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- 1. FIXED Header Banner (Behind status bar with safe insets) -->
    <LinearLayout
        android:id="@+id/p16HeaderBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0F172A"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRACTICAL 16 (EX. 17) • AI DEV TOOLS"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI Developer Studio"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GitHub Copilot &amp; ChatGPT Codex Assistance Simulator"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- Status Pill Badges -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖 GitHub Copilot"
                android:textColor="#0369A1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_blue"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠 ChatGPT Codex"
                android:textColor="#065F46"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_green"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. Scrollable Content Area -->
    <ScrollView
        android:id="@+id/p16ScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#F8FAFC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Card 1: Interactive Prompt & Simulator Studio -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚡ AI Code Generation Studio"
                            android:textColor="#1E293B"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvToolActiveBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Copilot &amp; Codex"
                            android:textColor="#4338CA"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_pill_blue"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select an Android engineering task to simulate prompt-to-code generation:"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <!-- Quick Task Selector Chips -->
                    <RadioGroup
                        android:id="@+id/rgScenarios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="14dp">

                        <RadioButton
                            android:id="@+id/rbScenario1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1. Material 3 Login Form (XML Layout)"
                            android:textColor="#1E293B"
                            android:textSize="13sp"
                            android:checked="true"
                            android:padding="4dp" />

                        <RadioButton
                            android:id="@+id/rbScenario2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="2. Room Database Entity &amp; DAO (Java)"
                            android:textColor="#1E293B"
                            android:textSize="13sp"
                            android:padding="4dp" />

                        <RadioButton
                            android:id="@+id/rbScenario3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="3. Retrofit REST API Client (Java Call)"
                            android:textColor="#1E293B"
                            android:textSize="13sp"
                            android:padding="4dp" />

                        <RadioButton
                            android:id="@+id/rbScenario4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="4. Fix Android NullPointerException Crash"
                            android:textColor="#1E293B"
                            android:textSize="13sp"
                            android:padding="4dp" />
                    </RadioGroup>

                    <!-- Run AI Simulation Button -->
                    <Button
                        android:id="@+id/btnSimulateAI"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="⚡ Simulate AI Code Generation"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="12dp"
                        android:backgroundTint="#4F46E5" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: Simulated IDE Code Viewer & Terminal -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#0F172A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Terminal Top Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <!-- Fake Terminal Window Controls (🔴 🟡 🟢) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginEnd="10dp">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_pill_red"
                                android:layout_marginEnd="5dp" />
                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_pill_gray"
                                android:layout_marginEnd="5dp" />
                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_pill_green" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTerminalTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="IDE CODE VIEWER"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <!-- Copy Code Button -->
                        <Button
                            android:id="@+id/btnCopyCode"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="📋 Copy Code"
                            android:textAllCaps="false"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#334155"
                            app:cornerRadius="8dp" />
                    </LinearLayout>

                    <!-- Prompt Section Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#1E293B"
                        android:padding="12dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/tvPromptHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="// DEVELOPER CONTEXT / PROMPT:"
                            android:textColor="#38BDF8"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvPromptText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Create a Material 3 OutlinedTextField login form with modern validation in Android XML layout."
                            android:textColor="#E2E8F0"
                            android:textSize="12sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <!-- Generated Code Section Box -->
                    <TextView
                        android:id="@+id/tvGeneratedCodeHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="// SIMULATED AI GENERATED OUTPUT:"
                        android:textColor="#34D399"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="6dp" />

                    <!-- Code Container with Monospace Font -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#030712"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvGeneratedCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="&lt;com.google.android.material.textfield.TextInputLayout\n    android:layout_width=&quot;match_parent&quot;\n    android:layout_height=&quot;wrap_content&quot;\n    android:hint=&quot;Email Address&quot;\n    style=&quot;@style/Widget.Material3.TextInputLayout.OutlinedBox&quot;&gt;\n\n    &lt;com.google.android.material.textfield.TextInputEditText\n        android:id=&quot;@+id/etEmail&quot;\n        android:layout_width=&quot;match_parent&quot;\n        android:layout_height=&quot;wrap_content&quot;\n        android:inputType=&quot;textEmailAddress&quot; /&gt;\n&lt;/com.google.android.material.textfield.TextInputLayout&gt;"
                            android:textColor="#F1F5F9"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="4dp" />
                    </HorizontalScrollView>

                    <!-- AI Insights Explanation -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#1E293B"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡 AI Execution Insights:"
                            android:textColor="#FBBF24"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvAiInsight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="GitHub Copilot autocompletes XML tag attributes in real-time as you type, while ChatGPT Codex can generate complete layouts with matching Java/Kotlin binding boilerplate."
                            android:textColor="#CBD5E1"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 3: Head-to-Head Architectural Comparison -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚔️ Copilot vs ChatGPT Codex Comparison"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Feature 1: Architecture & Model -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#F1F5F9"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. Core Model &amp; Architecture"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Copilot: Fine-tuned OpenAI Codex/GPT-4o engine built specifically for low-latency inline code completions."
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Codex: Conversational Large Language Model specialized in full-logic generation, multi-file code explanation, and conversational debugging."
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Feature 2: Android Studio Integration -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#F1F5F9"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. IDE Integration (Workflow)"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Copilot: Seamless Android Studio Plugin. Suggestions appear as grey 'Ghost Text'. Accept with Tab key."
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Codex: Used via ChatGPT web portal, API endpoints, or terminal CLI for architectural planning and bug solving."
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Feature 3: Context Scope -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#F1F5F9"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3. Context Awareness Scope"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Copilot: Reads adjacent open editor tabs, cursor position, existing imports, and Java docstrings."
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Codex: Takes explicit user instructions, conversation turn history, and full pasteable file snippets."
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Feature 4: Best Use Case -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#F1F5F9"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4. Best Use Cases for Android Devs"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Copilot: Rapid boilerplate, RecyclerView Adapters, XML layouts, getter/setters, repetitive switch statements."
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Codex: Algorithm design, Logcat crash trace diagnosis, architecture refactoring, unit test creation."
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 4: Android Studio Setup Roadmap -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛠️ Android Studio Copilot Setup Roadmap"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Step 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/bg_pill_blue"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Open Plugins Marketplace"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Navigate to File → Settings (or Android Studio → Preferences on macOS) → Plugins → Marketplace tab."
                                android:textColor="#64748B"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Step 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:text="2"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/bg_pill_blue"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Install GitHub Copilot Plugin"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Search 'GitHub Copilot' published by GitHub, click Install, and restart Android Studio."
                                android:textColor="#64748B"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Step 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:text="3"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/bg_pill_blue"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Authorize GitHub Account"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Click Tools → GitHub Copilot → Login to GitHub. Enter 8-character device verification code."
                                android:textColor="#64748B"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Step 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:text="4"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/bg_pill_blue"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Accept Ghost Code with Tab"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Type a descriptive comment (e.g. // Fetch Retrofit User List) and press Tab to accept inline ghost text!"
                                android:textColor="#64748B"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 5: External Viva Tips & Golden Rules -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎓 External Viva &amp; Developer Safety Rules"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠️ 1. Watch for Hallucinations: AI may recommend deprecated Android APIs (e.g., ProgressDialog or AsyncTask). Always verify code compatibility."
                        android:textColor="#DC2626"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔒 2. Never Leak API Keys: Do not include Google Maps, Firebase, or Payment gateway secret keys inside prompts or public repos."
                        android:textColor="#D97706"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🧪 3. Always Run Unit Tests: AI-generated code should always be verified with automated JUnit tests before pushing to production."
                        android:textColor="#059669"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Centered Student Watermark for Manual Evaluation -->
            <TextView
                android:id="@+id/tvStudentWatermark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Designed &amp; Developed by Arpit • GP Bhuj"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
