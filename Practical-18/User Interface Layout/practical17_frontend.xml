<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#064E3B">

    <!-- 1. FIXED Header Banner (Behind status bar with safe insets) -->
    <LinearLayout
        android:id="@+id/p17HeaderBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#064E3B"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRACTICAL 17 (EX. 18) • APPLICATION DEPLOYMENT"
            android:textColor="#6EE7B7"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APK Deployment Hub"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generate, Inspect, Sign &amp; Export Android Packages"
            android:textColor="#A7F3D0"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- Status Badges -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦 APK Export"
                android:textColor="#065F46"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_green"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ Signed Release"
                android:textColor="#1E40AF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_blue"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. Scrollable Content Area -->
    <ScrollView
        android:id="@+id/p17ScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#F8FAFC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Card 1: Live Device App & APK Inspector -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🔍 Live Device APK Inspector"
                            android:textColor="#1E293B"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLiveInspectorBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live Active"
                            android:textColor="#065F46"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_pill_green"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Real-time metadata read directly from this installed APK file:"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginBottom="14dp" />

                    <!-- Metadata Grid Container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#F8FAFC"
                        android:padding="12dp"
                        android:layout_marginBottom="14dp">

                        <!-- Package ID -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">
                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Application ID:"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvAppId"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="com.example.arpitapplication"
                                android:textColor="#0F172A"
                                android:textSize="12sp"
                                android:fontFamily="monospace" />
                        </LinearLayout>

                        <!-- Version Info -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">
                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Version Code/Name:"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvVersionInfo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="1.0 (Version Code: 1)"
                                android:textColor="#0F172A"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Build Variant -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">
                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Build Variant:"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvBuildVariant"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🟢 DEBUG (Debug Keystore)"
                                android:textColor="#059669"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- SDK Info -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">
                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Target / Min SDK:"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvSdkInfo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Target: API 36 | Min: API 29"
                                android:textColor="#0F172A"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Live APK Size -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">
                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Live APK Size:"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvApkSize"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Calculating size..."
                                android:textColor="#0284C7"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Install Date -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">
                            <TextView
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                android:text="Installed Time:"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvInstallDate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Reading timestamp..."
                                android:textColor="#0F172A"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Installed APK File Path -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Internal APK Storage Path:"
                                android:textColor="#64748B"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="2dp" />
                            <TextView
                                android:id="@+id/tvApkPath"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="/data/app/..."
                                android:textColor="#475569"
                                android:textSize="11sp"
                                android:fontFamily="monospace"
                                android:background="#E2E8F0"
                                android:padding="6dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Action Buttons Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Refresh Inspector -->
                        <Button
                            android:id="@+id/btnRefreshInspector"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="🔄 Refresh"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            android:textColor="#1E293B"
                            android:backgroundTint="#E2E8F0"
                            app:cornerRadius="10dp"
                            android:layout_marginEnd="8dp" />

                        <!-- Share / Export APK -->
                        <Button
                            android:id="@+id/btnShareApk"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1.6"
                            android:text="📤 Share / Export APK"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:backgroundTint="#059669"
                            app:cornerRadius="10dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: What is Inside an APK? (Anatomy) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 What is Inside an APK? (Anatomy)"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="An APK is a specialized ZIP archive containing these core components:"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <!-- Component 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#F1F5F9"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. classes.dex (Dalvik Executable)"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Compiled Java/Kotlin source code transformed into Dalvik/ART bytecode executed by Android Virtual Machine."
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Component 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#F1F5F9"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2. res/ &amp; resources.arsc"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pre-compiled binary XML resources (layouts, drawables, animations) and indexed strings/ID table for fast runtime lookup."
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Component 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#F1F5F9"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3. AndroidManifest.xml (Binary Encoded)"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="The compiled root descriptor specifying app package, Activities, services, permissions, and minimum/target SDK requirements."
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Component 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#F1F5F9"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4. META-INF/ (Signatures &amp; Security)"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contains CERT.RSA, CERT.SF, and MANIFEST.MF containing SHA cryptographic hashes to verify app authenticity and prevent tampering."
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 3: Android Studio APK Generation Guide -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛠️ Step-by-Step APK Generation Guide"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Flow 1: Debug APK -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#EFF6FF"
                        android:padding="12dp"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟢 Method 1: Building Debug APK (For Testing)"
                            android:textColor="#1E40AF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. In Android Studio, go to menu: Build → Build Bundle(s) / APK(s) → Build APK(s).\n2. Alternatively, run Gradle CLI command: ./gradlew assembleDebug.\n3. Output Location: app/build/outputs/apk/debug/app-debug.apk."
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <!-- Flow 2: Signed Release APK -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#ECFDF5"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡️ Method 2: Generating Signed Release APK (Play Store)"
                            android:textColor="#065F46"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1. Menu: Build → Generate Signed Bundle / APK... → Select APK.\n2. Key store path: Create new Keystore (.jks) with password &amp; alias.\n3. Build Variants: Select 'release'.\n4. Signature Versions: Check 'V1 (JAR)' and 'V2 (Full APK Signature)'.\n5. Click Finish → Signed APK generated at: app/release/app-release.apk."
                            android:textColor="#334155"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 4: Debug APK vs Release APK Comparison -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚔️ Debug APK vs. Signed Release APK"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Criteria 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="Keystore:"
                            android:textColor="#0F172A"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Debug: Default debug.keystore\nRelease: Private developer .jks file"
                            android:textColor="#334155"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Criteria 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="Debuggable:"
                            android:textColor="#0F172A"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Debug: android:debuggable=true\nRelease: android:debuggable=false"
                            android:textColor="#334155"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Criteria 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="Optimization:"
                            android:textColor="#0F172A"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Debug: Unminified for debugging\nRelease: R8/Proguard code shrinking enabled"
                            android:textColor="#334155"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Criteria 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:text="Play Store:"
                            android:textColor="#0F172A"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Debug: Strictly Rejected\nRelease: Accepted (.aab / .apk)"
                            android:textColor="#334155"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 5: External Viva Deployment Tips -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎓 External Viva &amp; Deployment Rules"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔑 1. Keystore Security: If you lose your Release Keystore (.jks), you can NEVER update your published app on Google Play Store. Always back it up securely!"
                        android:textColor="#DC2626"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📱 2. AAB (Android App Bundle): Google Play now mandates .aab publishing format instead of standalone .apk so Google Play delivers only the device-specific APK (reducing download size by 15-30%)."
                        android:textColor="#D97706"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🛡️ 3. Signature Schemes (V1 vs V2 vs V3): V1 signs individual JAR files; V2 signs the entire APK binary protecting it against tampering and speeding up verification on device install."
                        android:textColor="#059669"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Centered Student Watermark for Manual Evaluation -->
            <TextView
                android:id="@+id/tvStudentWatermark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Designed &amp; Developed by Arpit • GP Bhuj"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
