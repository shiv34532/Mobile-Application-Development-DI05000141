<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- 1. Simple, Elegant News Header Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#B91C1C"
        android:paddingLeft="24dp"
        android:paddingTop="26dp"
        android:paddingRight="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Top Headlines"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="India &amp; World News • Live Updates"
            android:textColor="#FECACA"
            android:textSize="13sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <!-- 2. Centered Action & Status Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="14dp">

            <!-- Centered Fetch Button -->
            <Button
                android:id="@+id/btnFetchPosts"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:minWidth="220dp"
                android:layout_gravity="center_horizontal"
                android:text="⚡ Fetch Latest News"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:backgroundTint="#B91C1C"
                android:layout_marginBottom="8dp" />

            <!-- Progress Bar Loader -->
            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="#B91C1C"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <!-- Status Pill Badge -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="🟢 Tap above or swipe down to fetch news"
                android:textColor="#065F46"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_green"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- Pull to refresh hint -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Swipe down ⤓ anytime to refresh"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="6dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. SwipeRefreshLayout wrapping RecyclerView for Pull-to-Refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPosts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 4. Centered Student Name for Manual Output Verification -->
    <TextView
        android:id="@+id/tvStudentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Arpit"
        android:textColor="#B91C1C"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp" />

</LinearLayout>
