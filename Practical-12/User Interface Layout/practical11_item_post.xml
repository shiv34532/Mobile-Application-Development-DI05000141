<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardNewsItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Left Side: Source Badge, Headline, Snippet & Tap-to-Read -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="12dp">

            <!-- Category / Source Badge -->
            <TextView
                android:id="@+id/tvPostIdBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Top Story • Live"
                android:textColor="#991B1B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_red"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginBottom="4dp" />

            <!-- News Headline / Title (Max 3 lines) -->
            <TextView
                android:id="@+id/tvPostTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="News Headline Title Appears Here..."
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="4dp" />

            <!-- News Snippet (Max 2 lines) -->
            <TextView
                android:id="@+id/tvPostBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Short description of the news article..."
                android:textColor="#475569"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="6dp" />

            <!-- Timestamp and Browser Read Prompt -->
            <TextView
                android:id="@+id/tvNewsMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to read full story ↗"
                android:textColor="#DC2626"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Right Side: Server News Image with Rounded Corners -->
        <androidx.cardview.widget.CardView
            android:layout_width="95dp"
            android:layout_height="95dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1F5F9">

            <ImageView
                android:id="@+id/ivNewsImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="News Image" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.cardview.widget.CardView>
