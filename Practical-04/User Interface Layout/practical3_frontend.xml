<?xml version="1.0" encoding="utf-8"?>
<!-- 1. ConstraintLayout: Root layout for full screen -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- 2. FrameLayout: Main container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 3. RelativeLayout: To position Display at top/center and Keypad at bottom -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 4. LinearLayout: To arrange buttons in rows (Keypad) -->
            <LinearLayout
                android:id="@+id/keypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4">
                    <Button android:id="@+id/btn7" android:text="7" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="?attr/colorSurfaceVariant" android:textColor="?android:attr/textColorPrimary" android:textSize="32sp" />
                    <Button android:id="@+id/btn8" android:text="8" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="?attr/colorSurfaceVariant" android:textColor="?android:attr/textColorPrimary" android:textSize="32sp" />
                    <Button android:id="@+id/btn9" android:text="9" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="?attr/colorSurfaceVariant" android:textColor="?android:attr/textColorPrimary" android:textSize="32sp" />
                    <Button android:id="@+id/btnDiv" android:text="/" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="#1A73E8" android:textColor="#FFFFFF" android:textSize="32sp" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4">
                    <Button android:id="@+id/btn4" android:text="4" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="?attr/colorSurfaceVariant" android:textColor="?android:attr/textColorPrimary" android:textSize="32sp" />
                    <Button android:id="@+id/btn5" android:text="5" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="?attr/colorSurfaceVariant" android:textColor="?android:attr/textColorPrimary" android:textSize="32sp" />
                    <Button android:id="@+id/btn6" android:text="6" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="?attr/colorSurfaceVariant" android:textColor="?android:attr/textColorPrimary" android:textSize="32sp" />
                    <Button android:id="@+id/btnMul" android:text="*" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="#1A73E8" android:textColor="#FFFFFF" android:textSize="32sp" />
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4">
                    <Button android:id="@+id/btn1" android:text="1" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="?attr/colorSurfaceVariant" android:textColor="?android:attr/textColorPrimary" android:textSize="32sp" />
                    <Button android:id="@+id/btn2" android:text="2" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="?attr/colorSurfaceVariant" android:textColor="?android:attr/textColorPrimary" android:textSize="32sp" />
                    <Button android:id="@+id/btn3" android:text="3" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="?attr/colorSurfaceVariant" android:textColor="?android:attr/textColorPrimary" android:textSize="32sp" />
                    <Button android:id="@+id/btnSub" android:text="-" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="#1A73E8" android:textColor="#FFFFFF" android:textSize="32sp" />
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4">
                    <Button android:id="@+id/btnClear" android:text="C" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="#EA4335" android:textColor="#FFFFFF" android:textSize="32sp" />
                    <Button android:id="@+id/btn0" android:text="0" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="?attr/colorSurfaceVariant" android:textColor="?android:attr/textColorPrimary" android:textSize="32sp" />
                    <Button android:id="@+id/btnEqual" android:text="=" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="#1A73E8" android:textColor="#FFFFFF" android:textSize="32sp" />
                    <Button android:id="@+id/btnAdd" android:text="+" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="8dp" android:backgroundTint="#1A73E8" android:textColor="#FFFFFF" android:textSize="32sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Display Screen taking the top space above keypad -->
            <HorizontalScrollView
                android:id="@+id/scrollDisplay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/keypad"
                android:layout_alignParentTop="true"
                android:fillViewport="true">
                
                <TextView
                    android:id="@+id/tvDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="bottom|end"
                    android:padding="24dp"
                    android:text=""
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:singleLine="true" />
            </HorizontalScrollView>

        </RelativeLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
