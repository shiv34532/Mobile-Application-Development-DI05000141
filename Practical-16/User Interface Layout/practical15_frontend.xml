<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#4F46E5">

    <!-- 1. FIXED Header Banner (Behind status bar with safe insets) -->
    <LinearLayout
        android:id="@+id/p15HeaderBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#4F46E5"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRACTICAL 15 • MOBILE HARDWARE SENSORS"
            android:textColor="#C7D2FE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accelerometer Tilt Arena"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:layout_marginTop="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Real-Time 3-Axis Physics &amp; Tilt Ball Simulation"
            android:textColor="#E0E7FF"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- Status Pill Badges -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvSensorStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📳 Sensor Active"
                android:textColor="#065F46"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_green"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤 Student: Arpit"
                android:textColor="#1E40AF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_blue"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. Scrollable Content Area (Starts below header, scrolls under header) -->
    <ScrollView
        android:id="@+id/p15ScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#F8FAFC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Card 1: Live 3-Axis Force & Posture HUD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="3-Axis Accelerometer HUD"
                            android:textColor="#1E293B"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Dynamic Posture Badge -->
                        <TextView
                            android:id="@+id/tvOrientationBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟢 Balanced"
                            android:textColor="#1E40AF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_pill_blue"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp" />
                    </LinearLayout>

                    <!-- 3 Telemetry Values Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <!-- X-Axis -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="#F1F5F9"
                            android:padding="10dp"
                            android:layout_marginEnd="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="X (LEFT/RIGHT)"
                                android:textColor="#64748B"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tvValX"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.00"
                                android:textColor="#0F172A"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Y-Axis -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="#F1F5F9"
                            android:padding="10dp"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Y (TILT F/B)"
                                android:textColor="#64748B"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tvValY"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.00"
                                android:textColor="#0F172A"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Z-Axis -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="#F1F5F9"
                            android:padding="10dp"
                            android:layout_marginStart="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Z (GRAVITY)"
                                android:textColor="#64748B"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tvValZ"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="9.81"
                                android:textColor="#0F172A"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Motion Gesture Status -->
                    <TextView
                        android:id="@+id/tvShakeHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tip: Shake your phone to scatter balls &amp; trigger haptics! Shakes: 0"
                        android:textColor="#4F46E5"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: Interactive Ball Physics Arena -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#0F172A">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Arena Header Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="10dp"
                        android:background="#1E293B">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎮 Interactive Physics Arena"
                            android:textColor="#F8FAFC"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBallCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 Balls Active"
                            android:textColor="#38BDF8"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- The Custom Physics Canvas Frame -->
                    <FrameLayout
                        android:id="@+id/arenaContainer"
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        android:background="#0F172A" />

                    <!-- Arena Footer Note -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tilt phone in any direction to roll the balls &amp; bounce off walls!"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="10dp"
                        android:background="#1E293B" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action Controls Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnAddBall"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="➕ Add Ball"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp"
                    android:backgroundTint="#4F46E5"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnResetArena"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="🔄 Reset Balls"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp"
                    android:backgroundTint="#0284C7"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Card 3: Hardware Sensor Details (Viva Points) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hardware Sensor Specifications"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvSensorDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Detecting hardware sensor..."
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Student Watermark -->
            <TextView
                android:id="@+id/tvStudentWatermark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Designed &amp; Developed by Arpit • GP Bhuj"
                android:textColor="#4F46E5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
